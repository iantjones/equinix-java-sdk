<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.eqixiac.equinix</groupId>
        <artifactId>equinix-sdk-parent</artifactId>
        <version>2.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>equinix-sdk-samples</artifactId>
    <packaging>jar</packaging>

    <name>Equinix SDK for Java (Samples)</name>
    <description>Standalone, runnable example programs demonstrating the Equinix SDK for Java. These
        samples are illustrative only and are intentionally NOT published to Maven Central.</description>
    <url>https://github.com/iantjones/equinix-java-sdk/</url>

    <properties>
        <!--
            This module is examples-only. It must never be deployed to a repository.
            maven.deploy.skip short-circuits the deploy phase, and the plugin overrides
            below additionally neutralize the inherited central-publishing, gpg, source,
            and javadoc executions so no signed or publishable artifacts are produced.
        -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- The SDK itself; version comes from the parent dependencyManagement. -->
        <dependency>
            <groupId>com.eqixiac.equinix</groupId>
            <artifactId>equinix-sdk-java</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Disable Central publishing for this module. The plugin is inherited (with
                extensions=true) from the parent; setting skipPublishing keeps it from
                uploading or staging the samples artifact.
            -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>

            <!-- Do not GPG-sign samples artifacts: re-bind the inherited execution to no phase. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- Do not attach a sources jar for samples: re-bind the inherited execution to no phase. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- Do not attach a javadoc jar for samples: re-bind the inherited execution to no phase. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
