# Copy this file to .env.local (gitignored) and fill in your values.
# .env.local is read by run-live.ps1 / run-live.sh.

# ── Equinix REST API (client-credentials app from developer.equinix.com) ──
# Used by: mvn -Pintegration-readonly / -Pintegration-dryrun live tiers
EQUINIX_ACCESS_KEY=
EQUINIX_SECRET_KEY=

# ── Embedded Intelligence MCP Server (equinix-sdk-java-<v>-mcp-server.jar) ──
# The server reads the same two keys above: from its process environment first,
# then from a .env.local in its WORKING DIRECTORY (so point your MCP host's cwd
# here, or set the keys in the host config's "env" block instead).
# Only the two credential keys are read from .env.local. Everything else must be
# a real environment variable (set in the MCP host config), all optional:
#   EQUINIX_MCP_TOOLSETS          design,fabric,portal,ne,ibx,mutate (default: all read-only)
#   EQUINIX_SANDBOX               true → target the sandbox environment
#   EQUINIX_MCP_LOG_LEVEL         slf4j-simple stderr level (default: info)
#   EQUINIX_PEERINGDB_KEY         PeeringDB key for design_analyze_peering
#   GCP_BILLING_API_KEY           enables the live GCP egress-pricing adapter
#   EQUINIX_MCP_PRICING_TIMEOUT_MS  live-pricing hard timeout (default: 12000)
