# Copy this file to .env.local (gitignored) and fill in your values.
# .env.local is read by run-live.ps1 / run-live.sh and the MCP login tool.

# ── Equinix REST API (client-credentials app from developer.equinix.com) ──
# Used by: mvn -Pintegration-readonly / -Pintegration-dryrun live tiers
EQUINIX_ACCESS_KEY=
EQUINIX_SECRET_KEY=

# ── Equinix MCP (OAuth 2.1 via as.equinix.com - populated by McpLogin, do not fill by hand) ──
# One-time: java -cp target/classes api.equinix.javasdk.mcp.auth.McpLogin
# The tool performs the device-code flow and writes these back here.
EQUINIX_MCP_CLIENT_ID=
EQUINIX_MCP_REFRESH_TOKEN=
