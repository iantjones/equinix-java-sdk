{
  "functionalAreas": {
    "STS": {
      "hostName": "https://sts.eqix.equinix.com",
      "uriFormat": "v{$version}/{$rootUri}/{$requestUri}",
      "defaultVersion": 1,
      "Tokens": {
        "unauthenticated": true,
        "overrideUriFormat": "v{$version}/{$requestUri}",
        "serviceEndpoints": {
          "GenerateStsToken": { "httpMethod": "POST", "requestUri": "token" },
          "ListAccessPoliciesGranted": { "httpMethod": "POST", "requestUri": "accessPoliciesGranted" }
        }
      },
      "OidcProviders": {
        "overrideUriFormat": "v{$version}/{$requestUri}",
        "serviceEndpoints": {
          "PageOidcProviders": { "httpMethod": "GET", "requestUri": "projects/{$projectId}/oidcProviders" },
          "CreateOidcProvider": { "httpMethod": "POST", "requestUri": "projects/{$projectId}/oidcProviders" },
          "PatchOidcProvider": { "httpMethod": "PATCH", "requestUri": "projects/{$projectId}/oidcProviders/{$idpId}" },
          "DeleteOidcProvider": { "httpMethod": "DELETE", "requestUri": "projects/{$projectId}/oidcProviders/{$idpId}" },
          "SuspendOidcProvider": { "httpMethod": "POST", "requestUri": "projects/{$projectId}/oidcProviders/{$idpId}/suspend" },
          "ResumeOidcProvider": { "httpMethod": "POST", "requestUri": "projects/{$projectId}/oidcProviders/{$idpId}/resume" }
        }
      },
      "Discovery": {
        "unauthenticated": true,
        "overrideUriFormat": "{$requestUri}",
        "serviceEndpoints": {
          "GetJwks": { "httpMethod": "GET", "requestUri": "jwks" },
          "GetOpenIdConfiguration": { "httpMethod": "GET", "requestUri": ".well-known/openid-configuration" }
        }
      }
    }
  }
}
