# ----------------------------------------------------------------------------
# Equinix Fabric deployment - generated by the Equinix Java SDK
# Deployment Wizard (com.eqixiac.equinix.design.export.TerraformExporter).
#
# Deployment Plan: 4 Cloud Router(s), 12 provider connection(s), 6 backbone link(s), 36 routing protocol(s). Total resources: 58. Estimated monthly cost: $10797.34. VALIDATION ERRORS: 4 DEFERRED TO PROVISIONING: 12 (validated at provisioning; needs your authorization keys). BANDWIDTH ROUNDED UP: 2 connection(s) to the nearest service-profile tier (raises billed bandwidth).
#
# Review carefully before running `terraform apply`. Some provider attributes
# (e.g. credentials, account/project context) may need to be supplied via
# variables before this configuration is complete.
# ----------------------------------------------------------------------------

terraform {
  required_providers {
    equinix = {
      source = "equinix/equinix"
    }
  }
}

# === Required Customer Inputs ===
# Cloud provider connections need customer-gathered authorization at
# provisioning; supply these via terraform.tfvars or -var (never commit
# secrets to version control).

variable "FCR-TR-to-aws_auth_key" {
  type = string
  sensitive = true
  description = "AWS Account ID (12-digit) for connection FCR-TR-to-aws"
}

variable "FCR-TR-to-aws_vlan" {
  type = number
  description = "DOT1Q VLAN tag for connection FCR-TR-to-aws"
}

variable "FCR-TR-to-azure_auth_key" {
  type = string
  sensitive = true
  description = "Azure ExpressRoute service key (GUID) for connection FCR-TR-to-azure"
}

variable "FCR-TR-to-azure_vlan" {
  type = number
  description = "DOT1Q VLAN tag for connection FCR-TR-to-azure"
}

variable "FCR-TR-to-azure_peering_type" {
  type = string
  default = "PRIVATE"
  description = "Azure ExpressRoute peering type (PRIVATE or MICROSOFT) for connection FCR-TR-to-azure"
  validation {
    condition = contains(["PRIVATE", "MICROSOFT"], var.FCR-TR-to-azure_peering_type)
    error_message = "Azure peering type must be PRIVATE or MICROSOFT."
  }
}

variable "FCR-TR-to-gcp_auth_key" {
