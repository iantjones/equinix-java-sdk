# === Cloud Routers ===

resource "equinix_fabric_cloud_router" "fcr_FCR-TR" {
  name = "FCR-TR"
  type = "XF_ROUTER"
  package {
    code = "STANDARD"
  }
  location {
    metro_code = "TR"
  }
  project {
    project_id = var.project_id
  }
  notifications {
    type = "ALL"
    emails = ["noc@example.com"]
  }
}

