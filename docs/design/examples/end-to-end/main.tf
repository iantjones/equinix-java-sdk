# === Routing Protocols ===

resource "equinix_fabric_routing_protocol" "rp_FCR-DC-to-aws-DIRECT" {
  name = "FCR-DC-to-aws-DIRECT"
  type = "DIRECT"
  connection_uuid = equinix_fabric_connection.conn_FCR-DC-to-aws.id
  direct_ipv4 {
    equinix_iface_ip = "10.100.0.1/30"
  }
}

resource "equinix_fabric_routing_protocol" "rp_FCR-DC-to-aws-BGP" {
  name = "FCR-DC-to-aws-BGP"
  type = "BGP"
  connection_uuid = equinix_fabric_connection.conn_FCR-DC-to-aws.id
  customer_asn = 64512
  bgp_ipv4 {
    customer_peer_ip = "10.100.0.2/30"
    enabled = true
  }
  bfd {
    enabled = true
    interval = "300"
  }
  # Fabric requires the DIRECT protocol to exist before BGP on the same connection.
  depends_on = [equinix_fabric_routing_protocol.rp_FCR-DC-to-aws-DIRECT]
}

