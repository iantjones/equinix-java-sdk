# ----------------------------------------------------------------------------
# Equinix Fabric deployment - generated by the Equinix Java SDK
# Deployment Wizard (com.eqixiac.equinix.design.export.TerraformExporter).
#
# Deployment Plan: 3 Cloud Router(s), 5 provider connection(s), 3 backbone link(s), 16 routing protocol(s). Total resources: 27. Estimated monthly cost: $6823.99. DEFERRED TO PROVISIONING: 5 (validated at provisioning; needs your authorization keys). SKIPPED (could not validate now): 3 (offline or the API could not be reached - see the reasons). BANDWIDTH ROUNDED UP: 2 connection(s) to the nearest service-profile tier (raises billed bandwidth).
#
# Review carefully before running `terraform apply`. Some provider attributes
# (e.g. credentials, account/project context) may need to be supplied via
# variables before this configuration is complete.
# ----------------------------------------------------------------------------

terraform {
  required_providers {
    equinix = {
      source = "equinix/equinix"
    }
  }
}

# === Required Customer Inputs ===
# Cloud provider connections need customer-gathered authorization at
# provisioning; supply these via terraform.tfvars or -var (never commit
# secrets to version control).

variable "FCR-DC-to-aws_auth_key" {
  type = string
  sensitive = true
  description = "AWS Account ID (12-digit) for connection FCR-DC-to-aws"
}

variable "FCR-DC-to-aws_vlan" {
  type = number
  description = "DOT1Q VLAN tag for connection FCR-DC-to-aws"
}

variable "FCR-DC-to-azure_auth_key" {
  type = string
  sensitive = true
  description = "Azure ExpressRoute service key (GUID) for connection FCR-DC-to-azure"
}

variable "FCR-DC-to-azure_vlan" {
  type = number
  description = "DOT1Q VLAN tag for connection FCR-DC-to-azure"
}

variable "FCR-DC-to-azure_peering_type" {
  type = string
  default = "PRIVATE"
  description = "Azure ExpressRoute peering type (PRIVATE or MICROSOFT) for connection FCR-DC-to-azure"
  validation {
    condition = contains(["PRIVATE", "MICROSOFT"], var.FCR-DC-to-azure_peering_type)
    error_message = "Azure peering type must be PRIVATE or MICROSOFT."
  }
}

variable "FCR-FR-to-aws_auth_key" {
  type = string
  sensitive = true
  description = "AWS Account ID (12-digit) for connection FCR-FR-to-aws"
}

variable "FCR-FR-to-aws_vlan" {
  type = number
  description = "DOT1Q VLAN tag for connection FCR-FR-to-aws"
}

variable "FCR-FR-to-azure_auth_key" {
  type = string
  sensitive = true
  description = "Azure ExpressRoute service key (GUID) for connection FCR-FR-to-azure"
}

variable "FCR-FR-to-azure_vlan" {
  type = number
  description = "DOT1Q VLAN tag for connection FCR-FR-to-azure"
}

variable "FCR-FR-to-azure_peering_type" {
  type = string
  default = "PRIVATE"
  description = "Azure ExpressRoute peering type (PRIVATE or MICROSOFT) for connection FCR-FR-to-azure"
  validation {
    condition = contains(["PRIVATE", "MICROSOFT"], var.FCR-FR-to-azure_peering_type)
    error_message = "Azure peering type must be PRIVATE or MICROSOFT."
  }
}

variable "FCR-SG-to-gcp_auth_key" {
  type = string
  sensitive = true
  description = "GCP pairing key for connection FCR-SG-to-gcp"
}

variable "FCR-SG-to-gcp_vlan" {
  type = number
  description = "DOT1Q VLAN tag for connection FCR-SG-to-gcp"
}

variable "project_id" {
  type = string
  description = "Equinix project id for the Cloud Routers (the plan names none; the provider requires a project block)"
}

# === Cloud Routers ===

resource "equinix_fabric_cloud_router" "fcr_FCR-DC" {
  name = "FCR-DC"
  type = "XF_ROUTER"
  package {
    code = "STANDARD"
  }
  location {
    metro_code = "DC"
  }
  project {
    project_id = var.project_id
  }
  notifications {
    type = "ALL"
    emails = ["noc@example.com"]
  }
}

resource "equinix_fabric_cloud_router" "fcr_FCR-FR" {
  name = "FCR-FR"
