# === Provider Connections ===

resource "equinix_fabric_connection" "conn_FCR-TR-to-aws" {
  name = "FCR-TR-to-aws"
  type = "IP_VC"
  bandwidth = 5000
  notifications {
    type = "ALL"
    emails = ["noc@example.com"]
  }
  additional_info = [{ key = "eqxSdkDeployment", value = "global-interconnect" }, { key = "eqxSdkKey", value = "connection/TR/aws" }, { key = "eqxSdkPlan", value = "c502b0d151391174" }]
  a_side {
    access_point {
      type = "CLOUD_ROUTER"
      router {
        uuid = equinix_fabric_cloud_router.fcr_FCR-TR.id
      }
    }
  }
  z_side {
    access_point {
      type = "SP"
      authentication_key = var.FCR-TR-to-aws_auth_key
      profile {
        type = "L2_PROFILE"
        uuid = "de55ca94-df3b-4680-845f-6f7093f76bef"
      }
      link_protocol {
        type = "DOT1Q"
        vlan_tag = var.FCR-TR-to-aws_vlan
      }
      location {
        metro_code = "TR"
      }
      seller_region = "ca-central-1"
    }
  }
}

