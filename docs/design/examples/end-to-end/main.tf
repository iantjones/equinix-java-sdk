# === Provider Connections ===

resource "equinix_fabric_connection" "conn_FCR-DC-to-aws" {
  name = "FCR-DC-to-aws"
  type = "IP_VC"
  bandwidth = 5000
  notifications {
    type = "ALL"
    emails = ["noc@example.com"]
  }
  additional_info = [{ key = "eqxSdkDeployment", value = "global-interconnect" }, { key = "eqxSdkKey", value = "connection/DC/aws" }, { key = "eqxSdkPlan", value = "79db6cc07eaeb79b" }]
  a_side {
    access_point {
      type = "CLOUD_ROUTER"
      router {
        uuid = equinix_fabric_cloud_router.fcr_FCR-DC.id
      }
    }
  }
  z_side {
    access_point {
      type = "SP"
      authentication_key = var.FCR-DC-to-aws_auth_key
      profile {
        type = "L2_PROFILE"
        uuid = "de55ca94-df3b-4680-845f-6f7093f76bef"
      }
      link_protocol {
        type = "DOT1Q"
        vlan_tag = var.FCR-DC-to-aws_vlan
      }
      location {
        metro_code = "DC"
      }
      seller_region = "us-east-1"
    }
  }
}

