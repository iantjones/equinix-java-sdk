{
  "functionalAreas": {
    "CustomerPortal": {
      "uriFormat": "v{$version}/{$rootUri}/{$requestUri}",
      "defaultVersion": 2,
      "Invoices": {
        "rootUri": "invoices",
        "serviceEndpoints": {
          "ListInvoiceSummaries": {
            "httpMethod": "GET"
          },
          "ListInvoiceDetails": {
            "httpMethod": "GET",
            "requestUri": "details"
          }
        }
      },
      "Resellers": {
        "rootUri": "resellers",
        "serviceEndpoints": {
          "ListResellers": {
            "httpMethod": "GET"
          },
          "ListResellerCustomers": {
            "httpMethod": "GET",
            "requestUri": "{$accountNumber}/customers"
          },
          "GetResellerCustomer": {
            "httpMethod": "GET",
            "requestUri": "{$accountNumber}/customers/{$customerAccountNumber}"
          },
          "CreateResellerCustomer": {
            "httpMethod": "POST",
            "requestUri": "{$accountNumber}/customers"
          },
          "UpdateResellerCustomer": {
            "httpMethod": "PATCH",
            "requestUri": "{$accountNumber}/customers/{$customerAccountNumber}"
          },
          "RemoveResellerCustomer": {
            "httpMethod": "POST",
            "requestUri": "{$accountNumber}/customers/{$customerAccountNumber}/remove"
          }
        }
      },
      "CrossConnects": {
        "rootUri": "crossConnects",
        "serviceEndpoints": {
          "ListCrossConnects": {
            "httpMethod": "GET"
          },
          "GetCrossConnect": {
            "httpMethod": "GET",
            "requestUri": "{$uuid}"
          },
          "CreateCrossConnect": {
            "httpMethod": "POST"
          },
          "UpdateCrossConnect": {
            "httpMethod": "PUT",
            "requestUri": "{$uuid}"
          },
          "DeleteCrossConnect": {
            "httpMethod": "DELETE",
            "requestUri": "{$uuid}"
          }
        }
      },
      "Orders": {
        "rootUri": "colocations/v2/orders",
        "overrideUriFormat": "{$rootUri}/{$requestUri}",
        "serviceEndpoints": {
          "GetOrder": {
            "httpMethod": "GET",
            "requestUri": "{$orderId}"
          },
          "GetOrderNegotiations": {
            "httpMethod": "GET",
            "requestUri": "{$orderId}/negotiations"
          },
          "ReplyOrderNegotiation": {
            "httpMethod": "POST",
            "requestUri": "{$orderId}/negotiations"
          },
          "AddOrderNote": {
            "httpMethod": "POST",
            "requestUri": "{$orderId}/notes"
          },
          "CancelOrder": {
            "httpMethod": "POST",
            "requestUri": "{$orderId}/cancel"
          }
        }
      },
      "Shipments": {
        "rootUri": "shipments",
        "serviceEndpoints": {
          "ListShipments": {
            "httpMethod": "GET"
          },
          "GetShipment": {
            "httpMethod": "GET",
            "requestUri": "{$uuid}"
          },
          "CreateShipment": {
            "httpMethod": "POST"
          },
          "UpdateShipment": {
            "httpMethod": "PUT",
            "requestUri": "{$uuid}"
          },
          "CancelShipment": {
            "httpMethod": "DELETE",
            "requestUri": "{$uuid}"
          }
        }
      },
      "SmartHands": {
        "rootUri": "orders/smarthands",
        "defaultVersion": 1,
        "serviceEndpoints": {
          "CreateEquipmentInstall": {
            "httpMethod": "POST",
            "requestUri": "equipmentInstall"
          },
          "CreateShipmentUnpack": {
            "httpMethod": "POST",
            "requestUri": "shipmentUnpack"
          },
          "CreateMoveJumperCable": {
            "httpMethod": "POST",
            "requestUri": "moveJumperCable"
          },
          "CreateCageEscort": {
            "httpMethod": "POST",
            "requestUri": "cageEscort"
          },
          "CreateLocatePackage": {
            "httpMethod": "POST",
            "requestUri": "locatePackage"
          },
          "CreatePicturesDocument": {
            "httpMethod": "POST",
            "requestUri": "picturesDocument"
          },
          "CreatePatchCableInstall": {
            "httpMethod": "POST",
            "requestUri": "patchCableInstall"
          },
          "CreatePatchCableRemoval": {
            "httpMethod": "POST",
            "requestUri": "patchCableRemoval"
          },
          "CreateCageCleanup": {
            "httpMethod": "POST",
            "requestUri": "cageCleanup"
          },
          "CreateCableRequest": {
            "httpMethod": "POST",
            "requestUri": "cableRequest"
          },
          "CreateRunJumperCable": {
            "httpMethod": "POST",
            "requestUri": "runJumperCable"
          },
          "CreateOther": {
            "httpMethod": "POST",
            "requestUri": "other"
          },
          "ListSmartHandsLocations": {
            "httpMethod": "GET",
            "requestUri": "locations"
          },
          "ListSmartHandsTypes": {
            "httpMethod": "GET",
            "requestUri": "types"
          }
        }
      },
      "WorkVisits": {
        "rootUri": "workVisits",
        "serviceEndpoints": {
          "ListWorkVisits": {
            "httpMethod": "GET"
          },
          "GetWorkVisit": {
            "httpMethod": "GET",
            "requestUri": "{$uuid}"
          },
          "CreateWorkVisit": {
            "httpMethod": "POST"
          },
          "UpdateWorkVisit": {
            "httpMethod": "PUT",
            "requestUri": "{$uuid}"
          },
          "CancelWorkVisit": {
            "httpMethod": "DELETE",
            "requestUri": "{$uuid}"
          }
        }
      },
      "TroubleTickets": {
        "rootUri": "tickets",
        "serviceEndpoints": {
          "ListTroubleTickets": {
            "httpMethod": "GET"
          },
          "GetTroubleTicket": {
            "httpMethod": "GET",
            "requestUri": "{$uuid}"
          },
          "CreateTroubleTicket": {
            "httpMethod": "POST"
          },
          "UpdateTroubleTicket": {
            "httpMethod": "PUT",
            "requestUri": "{$uuid}"
          }
        }
      },
      "Notifications": {
        "rootUri": "notifications",
        "serviceEndpoints": {
          "ListNotifications": {
            "httpMethod": "GET"
          },
          "GetNotification": {
            "httpMethod": "GET",
            "requestUri": "{$uuid}"
          }
        }
      },
      "Assets": {
        "rootUri": "assets",
        "defaultVersion": 1,
        "serviceEndpoints": {
          "ListAssets": {
            "httpMethod": "GET"
          },
          "GetAsset": {
            "httpMethod": "GET",
            "requestUri": "{$uuid}"
          }
        }
      },
      "Quotes": {
        "rootUri": "quotes",
        "serviceEndpoints": {
          "ListQuotes": {
            "httpMethod": "GET"
          },
          "GetQuote": {
            "httpMethod": "GET",
            "requestUri": "{$uuid}"
          },
          "CreateQuote": {
            "httpMethod": "POST"
          }
        }
      },
      "SupportPlans": {
        "rootUri": "support/plans",
        "serviceEndpoints": {
          "ListSupportPlans": {
            "httpMethod": "GET"
          },
          "GetSupportPlan": {
            "httpMethod": "GET",
            "requestUri": "{$uuid}"
          }
        }
      },
      "OrderHistory": {
        "rootUri": "orders/history",
        "defaultVersion": 1,
        "serviceEndpoints": {
          "ListOrderHistory": {
            "httpMethod": "GET"
          },
          "GetOrderHistoryItem": {
            "httpMethod": "GET",
            "requestUri": "{$uuid}"
          }
        }
      },
      "Lookup": {
        "rootUri": "lookup",
        "serviceEndpoints": {
          "ListLocations": {
            "httpMethod": "GET",
            "requestUri": "locations"
          },
          "GetLocation": {
            "httpMethod": "GET",
            "requestUri": "locations/{$uuid}"
          },
          "ListPatchPanels": {
            "httpMethod": "GET",
            "requestUri": "patchPanels"
          }
        }
      },
      "Attachments": {
        "rootUri": "attachments",
        "defaultVersion": 1,
        "serviceEndpoints": {
          "ListAttachments": {
            "httpMethod": "GET"
          },
          "GetAttachment": {
            "httpMethod": "GET",
            "requestUri": "{$uuid}"
          },
          "UploadAttachment": {
            "httpMethod": "POST"
          },
          "DeleteAttachment": {
            "httpMethod": "DELETE",
            "requestUri": "{$uuid}"
          }
        }
      },
      "Reports": {
        "rootUri": "reports",
        "defaultVersion": 1,
        "serviceEndpoints": {
          "ListReports": {
            "httpMethod": "GET"
          },
          "GetReport": {
            "httpMethod": "GET",
            "requestUri": "{$uuid}"
          }
        }
      },
      "SecureCabinets": {
        "rootUri": "secureCabinets",
        "defaultVersion": 1,
        "serviceEndpoints": {
          "ListSecureCabinets": {
            "httpMethod": "GET"
          },
          "GetSecureCabinet": {
            "httpMethod": "GET",
            "requestUri": "{$uuid}"
          },
          "CreateSecureCabinet": {
            "httpMethod": "POST"
          },
          "UpdateSecureCabinet": {
            "httpMethod": "PUT",
            "requestUri": "{$uuid}"
          }
        }
      }
    }
  }
}