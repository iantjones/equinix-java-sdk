<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.eqixiac.equinix</groupId>
    <artifactId>equinix-sdk-java</artifactId>
    <version>2.0.1</version>
    <packaging>jar</packaging>

    <name>Equinix SDK for Java</name>
    <description>The Equinix SDK for Java provides Java APIs for creating and managing physical and virtual infrastructure products across Platform Equinix. Supported products include Equinix Fabric, Network Edge, Customer Portal, IBX SmartView, Internet Access, Projects, IAM, and STS.</description>
    <url>https://github.com/iantjones/equinix-java-sdk/</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Ian Jones</name>
            <email>iantjones@gmail.com</email>
            <organization>Personal</organization>
            <organizationUrl>https://github.com/iantjones</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/iantjones/equinix-java-sdk.git</connection>
        <developerConnection>scm:git:ssh://github.com/iantjones/equinix-java-sdk.git</developerConnection>
        <url>https://github.com/iantjones/equinix-java-sdk/</url>
    </scm>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <jackson.version>2.21.1</jackson.version>
        <junit-jupiter.version>5.10.3</junit-jupiter.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.13</version>
        </dependency>
        <!--
          slf4j-simple serves two roles: the test suites' logging backend (runtime scope keeps
          it on the test classpath) and the logging backend bundled into the shaded mcp-server
          jar (the shade plugin bundles compile+runtime artifacts; test scope would leave the
          runnable server jar without a binding). It is <optional> so library consumers never
          inherit a logging BINDING from this SDK — only the slf4j-api facade above is a real
          transitive dependency. Locked by DependencyHygieneTest.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit-jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit-jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit-jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>1.10.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.23.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.23.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.5.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
            <version>4.5.14</version>
        </dependency>
        <!--
          Override the commons-codec version brought in transitively by httpclient (1.11),
          which is flagged by WS-2019-0379 (input validation in the Base32/Base64 decoders,
          fixed in 1.13). A direct declaration wins Maven version mediation; httpclient 4.5.14
          is compatible with current commons-codec releases.
        -->
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
            <version>1.17.1</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>2.21</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jdk8</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.42</version>
            <scope>provided</scope>
        </dependency>
        <!--
          Official MCP Java SDK, used ONLY by the embedded MCP server
          (api.equinix.javasdk.mcp.server). Both are <optional> so SDK consumers'
          dependency trees are untouched; the runnable server ships as the shaded
          "mcp-server" classifier jar, which bundles them. mcp-json-jackson2 keeps
          the server on this project's Jackson 2 stack (the default mcp aggregate
          would pull Jackson 3).
        -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-core</artifactId>
            <version>2.0.0</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-json-jackson2</artifactId>
            <version>2.0.0</version>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.42</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <excludedGroups>wiremock,integration-readonly,integration-dryrun,integration-full,integration-scenario</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.0.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <javadocExecutable>${java.home}/bin/javadoc</javadocExecutable>
                    <source>21</source>
                    <doclint>none</doclint>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              Runnable embedded MCP server jar (target/${artifactId}-${version}-mcp-server.jar):
              `java -jar` it from Claude Desktop / Claude Code / Cursor / VS Code. Shade attaches
              it as the SECONDARY artifact with classifier 'mcp-server' (shadedArtifactAttached),
              so the primary library jar and its pom are untouched — createDependencyReducedPom
              is explicitly false because the default (true) would rewrite the pom that
              install/deploy publish. The uber jar bundles the SDK plus every compile/runtime
              dependency: the two <optional> io.modelcontextprotocol.sdk artifacts and their
              transitives (reactor-core, networknt json-schema-validator, ...), Jackson,
              HttpClient, slf4j-api and the <optional> slf4j-simple binding — a project's OWN
              optional dependencies are on its runtime classpath (optionality only stops
              consumers inheriting them), so shade includes them. Lombok is provided scope and
              is excluded automatically. Jar signature files are stripped (invalid once
              repackaged) and JPMS module descriptors dropped (a multi-module uber jar cannot
              carry any single module-info).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>mcp-server-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>mcp-server</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>api.equinix.javasdk.mcp.server.EquinixMcpServerMain</mainClass>
                                </transformer>
                                <!-- Merge META-INF/services across Jackson/Reactor/etc. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/*.EC</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.7</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                        <configuration>
                            <keyname>${gpg.keyname}</keyname>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.10.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>true</autoPublish>
                    <waitUntil>published</waitUntil>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
        </plugins>
    </reporting>

    <profiles>
        <profile>
            <id>wiremock</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.3.1</version>
                        <configuration>
                            <groups>wiremock</groups>
                            <excludedGroups combine.self="override"></excludedGroups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>integration-readonly</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.3.1</version>
                        <configuration>
                            <groups>integration-readonly</groups>
                            <excludedGroups combine.self="override"></excludedGroups>
                            <systemProperties>
                                <property>
                                    <name>accessKey</name>
                                    <value>${auth.access}</value>
                                </property>
                                <property>
                                    <name>secretKey</name>
                                    <value>${auth.secret}</value>
                                </property>
                                <property>
                                    <name>testMode</name>
                                    <value>readonly</value>
                                </property>
                            </systemProperties>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>integration-dryrun</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.3.1</version>
                        <configuration>
                            <groups>integration-readonly,integration-dryrun</groups>
                            <excludedGroups combine.self="override"></excludedGroups>
                            <systemProperties>
                                <property>
                                    <name>accessKey</name>
                                    <value>${auth.access}</value>
                                </property>
                                <property>
                                    <name>secretKey</name>
                                    <value>${auth.secret}</value>
                                </property>
                                <property>
                                    <name>testMode</name>
                                    <value>dryrun</value>
                                </property>
                            </systemProperties>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>integration-full</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.3.1</version>
                        <configuration>
                            <groups>integration-readonly,integration-dryrun,integration-full</groups>
                            <excludedGroups combine.self="override"></excludedGroups>
                            <systemProperties>
                                <property>
                                    <name>accessKey</name>
                                    <value>${auth.access}</value>
                                </property>
                                <property>
                                    <name>secretKey</name>
                                    <value>${auth.secret}</value>
                                </property>
                                <property>
                                    <name>testMode</name>
                                    <value>full</value>
                                </property>
                                <property>
                                    <name>confirmDestructive</name>
                                    <value>${confirm.destructive}</value>
                                </property>
                            </systemProperties>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Coverage gate. Opt-in (so a partial `mvn test` never false-fails on incomplete
            coverage data). Intended to run AFTER both test profiles have populated the merged
            target/jacoco.exec, e.g.:
                mvn clean test            (default suite -> jacoco.exec)
                mvn -P wiremock test      (appends the wiremock suite, no clean)
                mvn -P coverage jacoco:check
            Thresholds are set just below current combined coverage to catch regressions.
        -->
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.75</minimum>
                                        </limit>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.75</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!--
                                    Global per-package floor: no Java package may fall below 30%
                                    line coverage (combined default + wiremock execution). The
                                    weakest package today is ~35%, so this catches a new package
                                    shipping effectively untested without failing current code.
                                -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.30</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!--
                                    Per-package floors on the client-logic packages of the newest
                                    domains (IAM, STS), so a domain cannot ship with its request
                                    building / response handling effectively untested again. The
                                    model/json packages are intentionally excluded (mostly 1-line
                                    DTOs whose coverage is incidental).
                                -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>api.equinix.javasdk.iam.client.implementation</include>
                                        <include>api.equinix.javasdk.iam.client.internal.implementation</include>
                                        <include>api.equinix.javasdk.sts.client.implementation</include>
                                        <include>api.equinix.javasdk.sts.client.internal.implementation</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <haltOnFailure>true</haltOnFailure>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Opt-in mutation testing over the core module (the shared transport/serialization
            engine every domain rides on):
                mvn -P pit test-compile org.pitest:pitest-maven:mutationCoverage
            Scoped to core because PIT re-runs the unit suite per mutant; report lands in
            target/pit-reports. Not part of CI - run before releases or after core changes.
        -->
        <profile>
            <id>pit</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.17.3</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.2</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>api.equinix.javasdk.core.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>api.equinix.javasdk.core.*</param>
                            </targetTests>
                            <threads>4</threads>
                            <timestampedReports>false</timestampedReports>
                            <failWhenNoMutations>false</failWhenNoMutations>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
